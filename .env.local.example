# Copy to .env.local and fill in. NEVER commit .env.local.
# Register every var you add here in src/lib/env.ts (zod) so a missing value fails fast at
# boot instead of surfacing as a confusing runtime error deep inside a request.

# ── Site URL ──────────────────────────────────────────────
# Local dev can leave this unset. In production set it to the canonical host — if the deploy
# 308-redirects apex -> www, use www, or every absolute URL takes a needless redirect hop.
NEXT_PUBLIC_SITE_URL=

# ── Anthropic (required) ──────────────────────────────────
# console.anthropic.com > API keys
ANTHROPIC_API_KEY=

# ── Replicate (local only) ────────────────────────────────
# replicate.com > account > API tokens. Media generation for the landing and login surfaces.
# Fill this in LOCALLY; do not set it on the deploy. The generation scripts run on your machine
# and commit their output to public/ — the running app only serves those static files.
REPLICATE_API_TOKEN=

# ── Neon Postgres (required) ──────────────────────────────
# POOLED connection string from the Neon dashboard (the one with -pooler in the host).
DATABASE_URL=

# ── Auth (Better Auth) ────────────────────────────────────
# Required. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Sign-in providers (optional; each stays dark until filled).
# Google: Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# The authorized redirect URI must EXACTLY match <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (the 6-digit sign-in code + founder alerts) ─────
# Gmail SMTP on a Google Workspace account. GMAIL_APP_PASSWORD is a Google *app password*
# (myaccount.google.com/apppasswords), NOT the account password.
# Absent = email is dark, not broken: the sign-in code simply won't send.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Visible From address, if it should differ from the SMTP account above (e.g. noreply@yourdomain).
# Gmail SILENTLY rewrites From to the authenticated user unless this is a verified "Send mail as"
# alias on that account — so set it only after the alias exists AND is verified. Blank = GMAIL_USER.
MAIL_FROM=
# Reply-To + the address shown in copy ("reply to this email"). A separate alias from MAIL_FROM.
# Needs no Send-mail-as verification (Reply-To is unauthenticated), only to exist to catch replies.
# Falls back to MAIL_FROM, then GMAIL_USER.
SUPPORT_EMAIL=
FEEDBACK_TO=          # alert recipient; falls back to GMAIL_USER
ADMIN_EMAILS=         # comma-separated allowlist for /admin; unset = nobody is admin

# ── Add project keys below ────────────────────────────────
